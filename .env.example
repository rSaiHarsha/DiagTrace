# NVIDIA API KEY for LLM Inference & Text Embeddings
NVIDIA_API_KEY=nvapi-your-key-here

# Preferred NVIDIA LLM Model (e.g. meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct)
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# Preferred NVIDIA Embedding Model
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Qdrant Vector Database Keys & Configuration
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_HOST=localhost
QDRANT_PORT=6333
