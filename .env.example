# Preferred NVIDIA LLM Model (e.g. openai/gpt-oss-20b, openai/gpt-oss-120b, nvidia/llama-3.1-nemotron-70b-instruct)
NVIDIA_MODEL_NAME=openai/gpt-oss-20b

# Preferred NVIDIA Embedding Model
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# NVIDIA API KEY for LLM Inference & Text Embeddings
NVIDIA_API_KEY=your-nvidia-api-key-here

# Qdrant Cloud Vector Database Configuration
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key-here